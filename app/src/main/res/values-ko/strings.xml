    <string name="status_select_required">스캔하기 전에 사용 중인 카드를 선택하세요.</string>
    <string name="status_hold_card">%1$s 카드를 휴대전화 뒷면에 평평하게 대고 움직이지 마세요.</string>
    <string name="status_reading">%1$s 읽는 중…</string>
